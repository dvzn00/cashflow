# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave pública (novo padrão "sb_publishable_...").
# Projetos antigos podem usar NEXT_PUBLIC_SUPABASE_ANON_KEY no lugar.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Origem pública da aplicação, sem barra no fim.
# Só é necessária em produção: é para onde o link de confirmação de e-mail
# volta. Em desenvolvimento pode ficar vazia — a origem é lida da requisição.
NEXT_PUBLIC_SITE_URL=

# Server-only. Nunca exposta ao cliente. Usada por scripts de seed/manutenção.
# A aplicação não lê esta variável em tempo de execução.
SUPABASE_SECRET_KEY=
