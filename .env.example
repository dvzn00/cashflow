# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave pública (novo padrão "sb_publishable_...").
# Projetos antigos podem usar NEXT_PUBLIC_SUPABASE_ANON_KEY no lugar.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Server-only. Nunca exposta ao cliente. Usada por scripts de seed/manutenção.
SUPABASE_SECRET_KEY=
