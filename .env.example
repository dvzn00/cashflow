# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave pública (novo padrão "sb_publishable_...").
# Projetos antigos podem usar NEXT_PUBLIC_SUPABASE_ANON_KEY no lugar.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# OPCIONAL. Deixe vazia salvo se você usa domínio próprio.
# Quando vazia, a origem é lida dos cabeçalhos da requisição, o que já
# funciona em desenvolvimento e na Vercel. Preencha apenas para fixar um
# domínio canônico — e então com o endereço real, sem barra no fim.
NEXT_PUBLIC_SITE_URL=

# Server-only. Nunca exposta ao cliente. Usada por scripts de seed/manutenção.
# A aplicação não lê esta variável em tempo de execução.
SUPABASE_SECRET_KEY=
